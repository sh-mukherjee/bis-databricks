{
  "//": "Databricks Jobs API 2.1 payload — BIS cashless annual refresh (Free Edition safe).",
  "//_notes": [
    "Free Edition: serverless only, max 5 concurrent tasks. This job uses 4 sequential notebook tasks.",
    "Create via: Databricks UI > Workflows > Create Job > switch to JSON/Code view and paste, OR via CLI: databricks jobs create --json @jobs/annual_refresh.job.json",
    "git_url points at the public GitHub repo. Schedule is created PAUSED: set pause_status to UNPAUSED once a manual run succeeds.",
    "Widgets pass catalog/schema through; default bis/payments. Fallback catalog e.g. workspace also works.",
    "Schedule: annual (BIS Red Book drops autumn T+1). Quartz cron 0 0 7 11 11 ? = 07:00 UTC on 11 Nov yearly (6 fields; 5-field cron is invalid).",
    "Attribution: BIS statistics under https://www.bis.org/terms_conditions.htm"
  ],
  "name": "bis-cashless-annual-refresh",
  "tags": {
    "project": "bis-cashless",
    "medallion": "bronze-silver-gold",
    "source": "bis-data-portal"
  },
  "queue": { "enabled": true },
  "schedule": {
    "quartz_cron_expression": "0 0 7 11 11 ?",
    "timezone_id": "UTC",
    "pause_status": "PAUSED"
  },
  "git_source": {
    "git_url": "https://github.com/sh-mukherjee/bis-databricks",
    "git_provider": "gitHub",
    "git_branch": "main"
  },
  "job_clusters": [],
  "tasks": [
    {
      "task_key": "ingest_bronze",
      "description": "Download BIS bulk zip to Volume + overwrite bronze_cpmi_cashless",
      "notebook_task": {
        "notebook_path": "src/01_ingest_bronze",
        "base_parameters": { "catalog": "bis", "schema": "payments", "force_download": "true" },
        "source": "GIT"
      },
      "environment_key": "serverless",
      "timeout_seconds": 3600,
      "max_retries": 1
    },
    {
      "task_key": "silver_clean",
      "description": "Parse CODE:Label, cast types, dedupe -> silver + quarantine",
      "depends_on": [{ "task_key": "ingest_bronze" }],
      "notebook_task": {
        "notebook_path": "src/02_silver_clean",
        "base_parameters": { "catalog": "bis", "schema": "payments" },
        "source": "GIT"
      },
      "environment_key": "serverless",
      "timeout_seconds": 3600,
      "max_retries": 1
    },
    {
      "task_key": "gold_analytics",
      "description": "Build gold_country_year / gold_instrument_share / gold_yoy_growth",
      "depends_on": [{ "task_key": "silver_clean" }],
      "notebook_task": {
        "notebook_path": "src/03_gold_analytics",
        "base_parameters": { "catalog": "bis", "schema": "payments" },
        "source": "GIT"
      },
      "environment_key": "serverless",
      "timeout_seconds": 3600,
      "max_retries": 1
    },
    {
      "task_key": "validate",
      "description": "Row-count + expectation gate (fails job if silver/gold empty)",
      "depends_on": [{ "task_key": "gold_analytics" }],
      "notebook_task": {
        "notebook_path": "src/05_validate",
        "base_parameters": { "catalog": "bis", "schema": "payments" },
        "source": "GIT"
      },
      "environment_key": "serverless",
      "timeout_seconds": 900,
      "max_retries": 0
    }
  ],
  "environments": [
    {
      "environment_key": "serverless",
      "spec": { "client": "serverless" }
    }
  ]
}
